{
  "rules": {
    "usuarios": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "codigos": {
      "$codigo": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
      }
    },
    "amigos": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "convites": {
      "$dest": {
        ".read": "auth != null && auth.uid === $dest",
        "$host": {
          ".write": "auth != null && auth.uid === $host && (!newData.exists() || root.child('amigos').child($dest).child($host).exists())"
        }
      }
    }
  }
}
